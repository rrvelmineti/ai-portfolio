# Copy to .env and fill in locally. Never commit real values.
# Variables are added here as phases introduce them.
APP_ENV=local
LOG_LEVEL=INFO

# ---- Model gateway (Phase 0.2) -------------------------------------------
# A provider is used only when all of its variables are set; others are skipped.
# Log prompt/response text in gateway log lines (keep false outside local debugging).
DEBUG_LOG_PROMPTS=false

ANTHROPIC_API_KEY=
OPENAI_API_KEY=

AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
# Optional: embeddings deployment (used by the default-embed alias) and API version.
AZURE_OPENAI_EMBED_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=

# Bedrock: region plus standard AWS credentials (keys, AWS_PROFILE, or a role).
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_PROFILE=

GEMINI_API_KEY=
GROQ_API_KEY=

# ---- Database and auth (Phase 0.3) ----------------------------------------
# docker-compose.yml reads POSTGRES_*; apps read DATABASE_URL.
POSTGRES_USER=portfolio
POSTGRES_PASSWORD=
POSTGRES_DB=portfolio
DATABASE_URL=postgresql+psycopg://portfolio:CHANGE_ME@localhost:5432/portfolio
# Tests: admin connection used to create throwaway test databases.
TEST_DATABASE_URL=postgresql+psycopg://portfolio:CHANGE_ME@localhost:5432/portfolio

# Required. At least 32 bytes, e.g.: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
# Optional overrides (defaults shown).
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15
LOGIN_RATE_LIMIT=10
LOGIN_RATE_WINDOW_SECONDS=60
# Only behind a trusted reverse proxy that sets X-Forwarded-For.
TRUST_PROXY_HEADERS=false
# Proxy address ranges allowed to set X-Forwarded-For (required when TRUST_PROXY_HEADERS=true).
# The right-most address not in these ranges is the client, so visitors can't fake theirs.
TRUSTED_PROXY_CIDRS=

# scripts/seed_demo.py: passwords for the demo users (min 12 chars each).
DEMO_ADMIN_PASSWORD=
DEMO_ANALYST_PASSWORD=
DEMO_VIEWER_PASSWORD=
DEMO_REVIEWER_PASSWORD=

# ---- Hosted demo (Phase 0.6, ADR 0008) --------------------------------------
# Password for the restricted app role `ai_portfolio_app` (16+ chars). The migrate job
# (owner credentials) sets it; the app connects with it.
APP_DB_PASSWORD=
# Public demo AI limits (defaults shown). 0 disables AI calls.
DEMO_AI_GUEST_DAILY_CAP=15
DEMO_AI_DAILY_CAP=60
DEMO_AI_MONTHLY_CAP=1500
# AI calls per minute, per user and per client IP.
DEMO_AI_RATE_LIMIT=5
# Never on the public demo: unauthenticated cold-start and proxy diagnostics.
DEMO_DIAGNOSTICS=false
# Local only: run migrations when the app starts (deployments migrate from CI).
RUN_MIGRATIONS_ON_START=false

# ---- Observability (Phase 0.4) --------------------------------------------
# All optional: each integration is off while its variables are empty.
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=ai-portfolio-dev
# Leave empty for the default LangSmith endpoint.
LANGSMITH_ENDPOINT=
# Send prompt/response text to LangSmith (after the redaction hook). Keep false
# unless you need it for debugging.
LANGSMITH_LOG_CONTENT=false
SENTRY_DSN=

# ---- Guardrails (Phase 0.5) -----------------------------------------------
# spaCy model for Presidio (installed via uv; accuracy targets are measured on lg).
GUARDRAILS_SPACY_MODEL=en_core_web_lg
# Optional YAML: PII settings (mask_location, hipaa_safe_harbor) and tenant recognizers.
GUARDRAILS_CONFIG=
# Optional per-product policy YAML: blocked topics, link and tool allowlists.
GUARDRAILS_POLICY=
# LLM second opinion (fast alias) on borderline injection scores.
# Local ML injection classifier (ADR 0007). Fail closed when enabled but not downloaded:
#   uv run python scripts/download_guard_model.py
GUARD_ML_CLASSIFIER=true
GUARD_MODEL_DIR=
GUARD_ML_THREADS=
GUARD_LLM_CLASSIFIER=false
APPROVAL_TTL_HOURS=168
